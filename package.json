{
  "name": "paths-frontend",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:plain": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "nuxt prepare && vitest run",
    "test:watch": "nuxt prepare && vitest",
    "test:types": "nuxt prepare && vue-tsc --noEmit && tsc --noEmit",
    "test:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 test-storybook --url http://127.0.0.1:6006",
    "test:storybook:visual": "playwright test --config playwright-storybook.config.ts",
    "codegen:openapi": "orval",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test playwright-test/e2e/smoke-app.spec.ts"
  },
  "dependencies": {
    "@ionic/vue": "^8.7.17",
    "@tanstack/query-persist-client-core": "^5.91.19",
    "@tanstack/vue-query": "^5.92.9",
    "@vite-pwa/nuxt": "^1.1.1",
    "dexie": "^4.0.10",
    "dompurify": "^3.3.2",
    "marked": "^17.0.3",
    "nuxt": "^4.4.2",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@nuxt/test-utils": "^3.23.0",
    "@storybook/addon-a11y": "^8.6.3",
    "@storybook/addon-essentials": "^8.6.3",
    "@storybook/test": "^8.6.3",
    "@storybook/test-runner": "^0.22.1",
    "@storybook/vue3-vite": "^8.6.3",
    "axe-playwright": "^2.2.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "msw": "^2.7.0",
    "msw-storybook-addon": "^2.0.4",
    "orval": "^8.4.1",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "storybook": "^8.6.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.0.8",
    "vue-tsc": "^2.2.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
