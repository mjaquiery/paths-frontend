{
  "name": "paths-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:plain": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen:openapi": "rm -rf src/generated/types && orval",
    "schema:sync": "node scripts/sync-schema.mjs",
    "fixtures:build": "node scripts/build-fixtures.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "test-storybook --testTimeout=60000",
    "test:storybook:ci": "npm run build-storybook -- -o storybook-static && concurrently -k -s first \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:6006 && test-storybook --testTimeout=60000 --url http://localhost:6006\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "flyctl deploy --build-arg VITE_APP_VERSION=$(date -u +%Y-%m-%d)-$(git rev-parse --short HEAD)"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/vue": "^8.7.17",
    "@ionic/vue-router": "^8.7.17",
    "@tanstack/query-persist-client-core": "^5.91.19",
    "@tanstack/vue-query": "^5.92.9",
    "dexie": "^4.0.10",
    "dompurify": "^3.3.2",
    "marked": "^17.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/test-runner": "^0.24.4",
    "@storybook/vue3-vite": "^10.5.7",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vue/test-utils": "^2.4.6",
    "axe-playwright": "^2.2.2",
    "concurrently": "^10.0.4",
    "http-server": "^14.1.1",
    "jsdom": "^26.0.0",
    "msw": "^2.7.0",
    "msw-storybook-addon": "^2.0.4",
    "orval": "^8.24.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "storybook": "^10.5.7",
    "typescript": "^5.8.2",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^2.2.8",
    "wait-on": "^9.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
